model Pneumatic_DynamicTest "Multiphysics pneumatic cylinder — dynamic test version with internal valve schedule.
   Calibrated to ERM spec DTXY1000002C: 4 bar regulated supply.
   For FMU export use the input-driven model (Pneumatic_Station)."

  // ============================================================
  // PARAMETERS
  // ============================================================

  parameter Modelica.Units.SI.Pressure p_supply=400000 
    "Supply pressure regulated to 4 bar (ERM spec DTXY1000002C)";
  parameter Modelica.Units.SI.Pressure p_atm=101325 "Atmospheric pressure";
  parameter Real tau_fill(unit="s") = 0.10 "Pressure rise time constant";
  parameter Real tau_vent(unit="s") = 0.15 "Pressure decay time constant";

  parameter Modelica.Units.SI.Area A_piston=4.91e-4 "Piston area (25 mm bore)";
  parameter Modelica.Units.SI.Length stroke_max=0.050 "Max stroke (50 mm)";
  parameter Modelica.Units.SI.Length stroke_min=0.0 "Min stroke (retracted)";

  parameter Modelica.Units.SI.Mass m_piston=0.20 "Moving mass";
  parameter Real b_friction(unit="N.s/m") = 80.0 "Viscous friction";
  parameter Modelica.Units.SI.Force Fc_friction=12.0 "Coulomb friction";
  parameter Modelica.Units.SI.Force F_spring=25.0 "Return spring preload";
  parameter Real K_endstop(unit="N/m") = 1.0e6 "End-stop stiffness";
  parameter Real D_endstop(unit="N.s/m") = 500.0 "End-stop damping";
  parameter Modelica.Units.SI.Acceleration g=9.81 "Gravity";
  parameter Boolean vertical=true "True if cylinder is vertical";

  // Test schedule (4 events define 2 cycles)
  parameter Modelica.Units.SI.Time t_extend_1=0.5 "First extend command";
  parameter Modelica.Units.SI.Time t_retract_1=2.5 "First retract command";
  parameter Modelica.Units.SI.Time t_extend_2=4.5 "Second extend command";
  parameter Modelica.Units.SI.Time t_retract_2=6.5 "Second retract command";

  // ============================================================
  // OUTPUTS
  // ============================================================

  Modelica.Blocks.Interfaces.RealOutput piston_pos(unit="m")
    annotation (Placement(transformation(extent={{200,80},{220,100}})));
  Modelica.Blocks.Interfaces.RealOutput piston_v(unit="m/s")
    annotation (Placement(transformation(extent={{200,40},{220,60}})));
  Modelica.Blocks.Interfaces.RealOutput chamber_p(unit="Pa")
    annotation (Placement(transformation(extent={{200,0},{220,20}})));
  Modelica.Blocks.Interfaces.RealOutput F_pneumatic(unit="N")
    annotation (Placement(transformation(extent={{200,-40},{220,-20}})));
  Modelica.Blocks.Interfaces.BooleanOutput extended
    annotation (Placement(transformation(extent={{200,-80},{220,-60}})));
  Modelica.Blocks.Interfaces.BooleanOutput retracted
    annotation (Placement(transformation(extent={{200,-120},{220,-100}})));

  // ============================================================
  // STATES
  // ============================================================

  Real x_p(
    unit="m",
    start=0,
    fixed=true);
  Real v_p(
    unit="m/s",
    start=0,
    fixed=true);
  Real p_c(
    unit="Pa",
    start=101325,
    fixed=true);

  Real F_pneu(unit="N");
  Real F_grav(unit="N");
  Real F_endstop_top(unit="N");
  Real F_endstop_bot(unit="N");
  Real F_friction_total(unit="N");
  Real F_net(unit="N");

  // The internal valve command, computed from a numeric "phase" indicator
  // to avoid multi-branch elseif chains that the parser may reject.
  Boolean extend_cmd;

  // Helper: a pulse pattern using basic boolean expressions (AND of comparisons)
  // This is functionally equivalent to the elseif chain but uses simpler
  // expressions that the 3DEXPERIENCE Modelica parser accepts cleanly.

equation 
  // ============================================================
  // INTERNAL VALVE SCHEDULE
  // ============================================================
  // extend_cmd is TRUE during two windows:
  //   t_extend_1 <= time < t_retract_1   (cycle 1)
  //   t_extend_2 <= time < t_retract_2   (cycle 2)
  // Otherwise FALSE.
  extend_cmd = ((time >= t_extend_1) and (time < t_retract_1)) or ((time >=
    t_extend_2) and (time < t_retract_2));

  // ============================================================
  // PNEUMATIC SUBSYSTEM
  // ============================================================
  if extend_cmd then
    der(p_c) = (p_supply - p_c)/tau_fill;
  else
    der(p_c) = (p_atm - p_c)/tau_vent;
  end if;

  // ============================================================
  // FORCES ON PISTON
  // ============================================================
  F_pneu = (p_c - p_atm)*A_piston;

  if vertical then
    F_grav = -m_piston*g;
  else
    F_grav = 0;
  end if;

  if x_p > stroke_min then
    F_friction_total = -F_spring - b_friction*v_p - Fc_friction*tanh(v_p*100);
  else
    F_friction_total = -b_friction*v_p - Fc_friction*tanh(v_p*100);
  end if;

  if x_p >= stroke_max then
    F_endstop_top = -K_endstop*(x_p - stroke_max) - D_endstop*v_p;
  else
    F_endstop_top = 0;
  end if;

  if x_p <= stroke_min then
    F_endstop_bot = -K_endstop*(x_p - stroke_min) - D_endstop*v_p;
  else
    F_endstop_bot = 0;
  end if;

  F_net = F_pneu + F_grav + F_endstop_top + F_endstop_bot + F_friction_total;
  m_piston*der(v_p) = F_net;
  der(x_p) = v_p;

  // ============================================================
  // OUTPUTS
  // ============================================================
  piston_pos = x_p;
  piston_v = v_p;
  chamber_p = p_c;
  F_pneumatic = F_pneu;
  extended = x_p > (stroke_max - 0.002);
  retracted = x_p < (stroke_min + 0.002);

  annotation (experiment(
      StopTime=8,
      Interval=0.001,
      Tolerance=1e-4), Diagram(coordinateSystem(extent={{-220,-140},{220,120}})));

end Pneumatic_DynamicTest;
